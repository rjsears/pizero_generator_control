[Unit]
Description=WiFi Connectivity Watchdog
Documentation=https://github.com/rjsears/pizero_generator_control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wifi-watchdog.sh
Restart=always
RestartSec=30

# Persistent state directory (/var/lib/wifi-watchdog) so the reboot
# cooldown survives the reboot it is meant to limit
StateDirectory=wifi-watchdog

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifi-watchdog

# Environment variables for configuration (optional overrides)
# Uncomment and modify as needed:
#Environment="WATCHDOG_CHECK_INTERVAL=30"
#Environment="WATCHDOG_PING_TIMEOUT=5"
#Environment="WATCHDOG_PING_COUNT=3"
#Environment="WATCHDOG_GRACE_FAILURES=1"
#Environment="WATCHDOG_MAX_SOFT_RESETS=3"
#Environment="WATCHDOG_MAX_HARD_RESETS=2"
#Environment="WATCHDOG_REBOOT_COOLDOWN=3600"
#Environment="WATCHDOG_STATE_FILE=/var/lib/wifi-watchdog/state"
#Environment="WATCHDOG_REBOOT_GUARD_URL=http://localhost:8001/api/health"

[Install]
WantedBy=multi-user.target
